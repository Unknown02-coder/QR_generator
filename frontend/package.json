{
  "name": "@qr-generator/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.test.json --noEmit && vite build",
    "dev": "vite --port 5173 --strictPort",
    "preview": "vite preview",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.18.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
